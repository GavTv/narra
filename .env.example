# Google Gemini (free tier часто упирается в дневной лимит)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# OpenAI API (это НЕ подписка ChatGPT Plus) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter — удобно брать GPT через один ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Narra

# Опционально Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Кого пробовать первым: openai | openrouter | groq | gemini
AI_PROVIDER=openrouter
